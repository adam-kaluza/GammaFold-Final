{
  "name": "gammafold-final",
  "private": true,
  "version": "1.0.0",
  "description": "GammaFold Final — standalone synthetic assay evidence-review and constrained next-batch planning workbench using server-side gemini-4-carbon.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:static": "vite build --mode static --outDir dist-static",
    "start": "node server.ts",
    "preview": "vite preview",
    "preview:static": "vite preview --outDir dist-static",
    "test": "tsx --test src/domain/domain.test.ts server/server.test.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-static',{recursive:true,force:true});})\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
