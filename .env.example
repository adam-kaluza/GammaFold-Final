# GammaFold — Server-Side Environment Configuration Placeholders
# Copy to .env locally if needed, or inject via local environment variables.
# NEVER commit real API keys, expose GEMINI_API_KEY to client bundles, or bind this server to public interfaces.

# Loopback-only HTTP bind address and port (non-loopback HOST values are refused at startup):
HOST="127.0.0.1"
PORT="3000"

# Explicit opt-in gate for live server-side gemini-4-carbon requests (default false).
# Set to "true" ONLY during a deliberate local loopback session:
GAMMAFOLD_LIVE_MODE="false"

# Per-session live request budget and minimum cooldown between requests:
GAMMAFOLD_MAX_REQUESTS="5"
GAMMAFOLD_COOLDOWN_MS="10000"

# Required server-side credential for live gemini-4-carbon inference:
GEMINI_API_KEY="PLACEHOLDER_SERVER_SIDE_GEMINI_API_KEY"

# Centralized runtime model ID (must remain gemini-4-carbon; silent fallback is disabled):
GEMINI_MODEL="gemini-4-carbon"
